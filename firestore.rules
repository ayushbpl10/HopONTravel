rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isTripOwner(tripId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/trips/$(tripId)).data.vendorId == request.auth.uid;
    }

    function isValidBookingData() {
      let data = request.resource.data;
      return data.keys().hasAll(['tripId', 'travelerName', 'travelerPhone', 'batchId', 'totalPrice', 'createdAt', 'status', 'bookingId'])
        && data.travelerName is string 
        && data.travelerName.size() >= 2 
        && data.travelerName.size() <= 100
        && data.travelerPhone is string
        && data.travelerPhone.size() >= 8
        && data.travelerPhone.size() <= 20
        && data.status in ['pending', 'confirmed'];
    }

    // ─── TRIPS ──────────────────────────────────────────────────────
    match /trips/{tripId} {
      // Anyone can read published/upcoming trips
      allow read: if resource.data.isPublished == true
                  || resource.data.status == 'published'
                  || (isAuthenticated() && resource.data.vendorId == request.auth.uid)
                  || true;

      // Authenticated users can create trips with valid title size
      allow create: if isAuthenticated() 
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 150;

      // Only authenticated users can update (vendors for details, travellers for seat counts)
      allow update: if isAuthenticated();

      // Only the owning vendor can delete
      allow delete: if isAuthenticated()
                    && (resource.data.vendorId == request.auth.uid || resource.data.vendorId == null);
    }

    // ─── USERS & VENDORS ─────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAuthenticated();
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isOwner(vendorId) || isAuthenticated();
    }

    // ─── BOOKINGS ───────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Guest or logged-in users can create valid bookings
      allow create: if isAuthenticated() && isValidBookingData();

      // Public read for booking status lookup by bookingId / vendor dashboard
      allow read: if true;

      // Vendor can update booking status
      allow update: if isAuthenticated();

      allow delete: if false;
    }

    // ─── LIVE TRIPS ─────────────────────────────────────────────────
    match /live_trips/{tripId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isTripOwner(tripId);
    }

    // ─── ERROR LOGS ─────────────────────────────────────────────────
    match /error_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
